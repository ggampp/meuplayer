{
  "name": "meuplayer",
  "version": "1.2.0",
  "description": "MeuPlayer Web — VOD e TV ao vivo",
  "main": "main.js",
  "scripts": {
    "dev:web": "vite",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:frontend && go run ./cmd/server",
    "icons": "python scripts/generate-icons.py",
    "build:server": "powershell -ExecutionPolicy Bypass -File scripts/build-server.ps1",
    "build:win": "npm run build:frontend && npm run icons && npm run build:server && electron-builder --win",
    "build:linux": "npm run build:frontend && npm run icons && npm run build:server && electron-builder --linux",
    "build:mac": "npm run build:frontend && npm run icons && npm run build:server && electron-builder --mac",
    "start:desktop": "npm run build:frontend && electron .",
    "start:web": "npm start",
    "test:search": "node scripts/test-search.mjs"
  },
  "build": {
    "appId": "com.meuplayer.app",
    "productName": "MeuPlayer",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "!public/cache/**",
      "!public/app.jsx",
      "!public/app.js",
      "!public/nav.js",
      "!public/player.js",
      "!public/provider-modal.js",
      "!public/spatial-nav.js",
      "!public/rede-buzz-*.js"
    ],
    "extraResources": [
      {
        "from": "dist-server/meuplayer-server.exe",
        "to": "."
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*",
          "!cache/**",
          "!app.jsx",
          "!app.js",
          "!nav.js",
          "!player.js",
          "!provider-modal.js",
          "!spatial-nav.js",
          "!rede-buzz-store.js",
          "!rede-buzz-ui.js"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ggampp",
      "repo": "meuplayer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
